# SMTP Email Configuration for Contact Form

# Ionos SMTP Configuration
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=587
SMTP_USER=info@aspirefootballgroup.co.uk
SMTP_PASS=your-ionos-email-password

# Alternative SMTP settings for Ionos (if 587 doesn't work)
# SMTP_HOST=smtp.ionos.co.uk
# SMTP_PORT=465
# SMTP_SECURE=true

# Gmail SMTP (alternative option)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-app-password

# Notes:
# 1. For Ionos: Use your regular email password for info@aspirefootballgroup.co.uk
# 2. Try port 587 first (STARTTLS), if issues use port 465 (SSL)
# 3. Ensure SMTP is enabled in your Ionos email settings