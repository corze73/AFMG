# Ionos SMTP Configuration (Official Settings)

# RECOMMENDED: Port 587 with STARTTLS
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=587
SMTP_USER=info@aspirefootballgroup.co.uk
SMTP_PASS=your-ionos-password

# ALTERNATIVE: Port 465 with SSL
# SMTP_HOST=smtp.ionos.co.uk
# SMTP_PORT=465
# SMTP_USER=info@aspirefootballgroup.co.uk
# SMTP_PASS=your-ionos-password

# LAST RESORT: Port 25 (unsecured - not recommended)
# SMTP_HOST=smtp.ionos.co.uk
# SMTP_PORT=25
# SMTP_USER=info@aspirefootballgroup.co.uk
# SMTP_PASS=your-ionos-password

# Alternative hostnames to try if above don't work:
# SMTP_HOST=smtp.1and1.co.uk
# SMTP_HOST=auth.smtp.1and1.co.uk

# Ionos Requirements:
# - Port 587 with TLS/STARTTLS (recommended)
# - Port 465 with SSL (alternative)
# - Port 25 unsecured (last resort)
# - SMTP authentication must be enabled in Ionos control panel